# Environment variables for L-FUTURE backend
# Copy this file to .env and adjust values for your environment

# Server configuration
HOST=127.0.0.1
PORT=5000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-different-from-secret-key
DEV_MODE=false

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Session management
SESSION_TIMEOUT=3600

# HTTPS enforcement (set to true when behind a reverse proxy like nginx)
# Defaults to true in production, false in development
FORCE_HTTPS=false

# File uploads
UPLOADS_DIR=uploads/

# CORS (for production, restrict to your domain)
ALLOWED_ORIGINS=*

# Database (SQLite file path relative to backend/)
DATABASE_NAME=lfuture.db

# Logging
LOG_FILE=lfuture_backend.log

# Redis (for future session storage)
REDIS_URL=redis://localhost:6379/0

# Rate limiting (future implementation)
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW=900
# RATE_LIMIT_REGISTER_MAX=3
# RATE_LIMIT_REGISTER_WINDOW=3600

# Upload limits (future implementation)
# MAX_FILES_PER_USER=10
# MAX_TOTAL_SIZE_PER_USER=104857600

# Configuración de Sentry
SENTRY_DSN=
